{
  "name": "project-zomboid-server",
  "type": "module",
  "scripts": {
    "find:tracked": "git ls-files --cached --others --exclude-standard",
    "lint:js": "eslint --config ./.config/.eslint.config.mjs .",
    "lint:js:fix": "eslint --config ./.config/.eslint.config.mjs --fix .",
    "lint:python": "ruff check --config ./.config/ruff.toml --quiet .",
    "lint:python:fix": "ruff check --config ./.config/ruff.toml --fix --quiet .",
    "lint:yaml": "yamllint --config-file ./.config/.yamllint.yml --strict $(npm run --silent find:tracked '**/*.yml' '**/*.yaml')",
    "lint:shell": "shellcheck --rcfile=./.config/.shellcheckrc $(npm run --silent find:tracked '**/*.sh')",
    "lint:docker": "hadolint --config ./.config/.hadolint.yml $(npm run --silent find:tracked '**/Dockerfile' '**/Dockerfile.*' 'Dockerfile')",
    "format": "prettier --config ./.config/.prettierrc.yml --ignore-path ./.config/.prettierignore --write .",
    "format:check": "prettier --config ./.config/.prettierrc.yml --ignore-path ./.config/.prettierignore --check .",
    "lint:all": "npm run lint:js && npm run lint:python && npm run lint:yaml && npm run lint:shell && npm run lint:docker && npm run format:check",
    "ci:eslint": "eslint --config ./.config/.eslint.config.mjs --max-warnings 0 --no-color --quiet .",
    "ci:prettier": "prettier --config ./.config/.prettierrc.yml --ignore-path ./.config/.prettierignore --check --no-color ."
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "eslint-plugin-json": "^4.0.1",
    "prettier": "^3.5.0"
  }
}
